rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users (Seekers & Mentors)
    match /users/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId || 
        resource.data.role == 'mentor' || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mentor'
      );
      allow create: if request.auth != null && request.auth.uid == userId 
                    && (request.resource.data.role != 'mentor' || request.auth.token.firebase.sign_in_provider != 'anonymous');
      allow update: if request.auth != null && request.auth.uid == userId 
                    && (request.resource.data.role == resource.data.role || request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    // Guides - Public read, owner or admin write (for compatibility)
    match /guides/{guideId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == guideId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
      
      // Slots sub-collection
      match /slots/{slotId} {
        allow read: if true;
        allow write: if request.auth != null && (
          request.auth.uid == guideId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
      }
    }

    // Top-level guide_slots collection
    match /guide_slots/{slotId} {
      allow read: if true; // Anyone can see available slots
      
      // Create: Only authenticated non-anonymous guides can create slots for themselves
      allow create: if request.auth != null 
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.guideId == request.auth.uid;
                    
      // Update: Mentor owns the slot, or seeker books/releases it
      allow update: if request.auth != null && (
        resource.data.guideId == request.auth.uid ||
        (
          (request.resource.data.isBooked == true && request.resource.data.bookedBy == request.auth.uid) ||
          (resource.data.bookedBy == request.auth.uid && request.resource.data.isBooked == false) ||
          (resource.data.guideId == request.auth.uid)
        )
      );
      
      // Delete: Only slot owner can delete their slots if they are not booked
      allow delete: if request.auth != null 
                    && resource.data.guideId == request.auth.uid 
                    && resource.data.isBooked == false;
    }

    // Bookings - User can read/write their own
    match /bookings/{bookingId} {
      allow read: if request.auth != null && 
                  (request.auth.uid == resource.data.userId || 
                   request.auth.uid == resource.data.guideId);
      allow create: if request.auth != null && 
                    request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && 
                    (request.auth.uid == resource.data.userId || 
                     request.auth.uid == resource.data.guideId);
    }

    // Sessions - User and guide can read/write their sessions
    match /sessions/{sessionId} {
      allow read: if request.auth != null &&
                  (request.auth.uid == resource.data.userId || 
                   request.auth.uid == resource.data.guideId);
      allow create: if request.auth != null && 
                    (request.auth.uid == request.resource.data.userId || 
                     request.auth.uid == request.resource.data.guideId);
      allow update, delete: if request.auth != null && 
                            (request.auth.uid == resource.data.userId || 
                             request.auth.uid == resource.data.guideId);
      
      // Messages sub-collection - restricted to session participants
      match /messages/{messageId} {
        allow read, create: if request.auth != null && 
                            (request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId || 
                             request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.guideId);
      }
    }

    // Payments - User can read their own payments
    match /payments/{paymentId} {
      allow read: if request.auth != null && 
                  request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && 
                    request.auth.uid == request.resource.data.userId;
    }

    // Notifications - User can read/write their own
    match /notifications/{notificationId} {
      allow read: if request.auth != null && 
                  request.auth.uid == resource.data.userId;
      allow create: if request.auth != null; // System/Clients can create notifications
      allow update: if request.auth != null &&
                    request.auth.uid == resource.data.userId &&
                    request.resource.data.userId == resource.data.userId;
    }

    // Community forum - public read, authenticated author write
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null 
                    && resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }

    match /community_comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null 
                    && resource.data.authorId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }

    // Mentor reviews - public read, authenticated client write
    match /mentor_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.sessionId is string
                    && exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId))
                    && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'completed'
                    && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.userId == request.auth.uid
                    && get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.guideId == request.resource.data.mentorId;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }

  }
}
